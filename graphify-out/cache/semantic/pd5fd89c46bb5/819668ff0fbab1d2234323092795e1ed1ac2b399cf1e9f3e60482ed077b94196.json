w_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".context/features/scheduler.md", "source_location": null, "weight": 1.0}, {"source": "_context_features_scheduler_message_quota_gate", "target": "_context_features_billing_dunning", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".context/features/scheduler.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "scheduler_firewall_invariant", "label": "Firewall: o que o scheduler pode varrer (Appointment n\u00e3o-retroativo)", "nodes": ["_context_features_scheduler_mark_no_shows", "_context_features_scheduler_retroactive_invariant", "_context_features_google_calendar_externalevent_firewall", "_context_features_time_blocks_separate_table_firewall", "_context_features_appointments_retroactive"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".context/features/scheduler.md"}]}