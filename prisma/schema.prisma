// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum AppointmentStatus {
  PENDING
  CONFIRMED
  NOT_CONFIRMED
  CANCELED
  NO_SHOW
}

enum MessageType {
  CONFIRMATION
  REMINDER
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  QUOTA_BLOCKED
}

enum WhatsappStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  FAILED
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingProvider {
  ASAAS
  STRIPE
  PAGARME
}

enum ActorType {
  USER
  SYSTEM
  WEBHOOK
  ADMIN
  ANONYMOUS
}

enum IdentifierType {
  CPF
  PHONE
}

// Models
model User {
  id                         String         @id @default(cuid())
  name                       String
  email                      String         @unique
  password                   String
  clinicName                 String
  avgAppointmentValue        Decimal        @default(0) @db.Decimal(10, 2)
  evolutionInstanceName      String?        @unique
  whatsappStatus             WhatsappStatus @default(DISCONNECTED)
  whatsappPhoneNumber        String?
  whatsappConnectedAt        DateTime?
  // Sprint 8 — resiliência: quando a instância caiu e quando o tenant foi
  // avisado por email pela última vez (dedup de notificações do sweep).
  whatsappDisconnectedAt       DateTime?
  whatsappDisconnectNotifiedAt DateTime?
  lastQrcodeBase64           String?
  lastQrcodeAt               DateTime?
  cpf                        String?
  cpfHash                    String?
  emailVerifiedAt            DateTime?
  emailVerificationToken     String?        @unique
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  patientSlotCount Int @default(0)

  // Sprint 11 — LGPD soft-delete + purga (deletedAt != null = conta excluída;
  // patientsPurgedAt = quando a purga 30d apagou os dados de pacientes).
  deletedAt        DateTime?
  patientsPurgedAt DateTime?
  // Sprint 11 — prova de consentimento (um checkbox = termos + privacidade).
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  consentIp         String?

  patients          Patient[]
  appointments      Appointment[]
  settings          Settings?
  subscription      Subscription?
  patientQuotaSlots PatientQuotaSlot[]

  @@index([cpfHash])
  @@index([deletedAt])
}

model SignupAttempt {
  id            String   @id @default(cuid())
  ipAddress     String?
  emailHash     String
  cpfHash       String?
  fingerprint   String?
  succeeded     Boolean  @default(false)
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([emailHash, createdAt(sort: Desc)])
  @@index([cpfHash])
}

model Patient {
  id             String    @id @default(cuid())
  name           String
  phone          String
  phoneCanonical String    @default("")
  email          String?
  cpf            String?
  cpfHash        String?
  notes          String?
  userId         String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  quotaSlot    PatientQuotaSlot? @relation("PatientCurrentSlot")

  @@unique([userId, phone])
  @@unique([userId, cpfHash])
  @@index([userId])
  @@index([userId, archivedAt])
}

model Appointment {
  id                 String            @id @default(cuid())
  dateTime           DateTime
  durationMinutes    Int               @default(30)
  status             AppointmentStatus @default(PENDING)
  patientId          String
  userId             String
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  confirmedAt        DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageLogs MessageLog[]

  @@index([userId])
  @@index([patientId])
  @@index([dateTime])
  @@index([status])
  // Índices compostos das queries cross-tenant do scheduler (Sprint 6):
  // sendConfirmations filtra (status, confirmationSentAt); markNoShows (status, dateTime).
  @@index([status, confirmationSentAt])
  @@index([status, dateTime])
}

model MessageLog {
  id            String        @id @default(cuid())
  appointmentId String
  type          MessageType
  sentAt        DateTime      @default(now())
  response      String?
  respondedAt   DateTime?
  status        MessageStatus @default(SENT)
  createdAt     DateTime      @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   PlanTier           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               BillingProvider?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  adminOverrideUntil     DateTime?
  adminOverrideReason    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

model PatientQuotaSlot {
  id             String         @id @default(cuid())
  userId         String
  identifierType IdentifierType
  identifierHash String
  patientId      String?        @unique
  firstSeenAt    DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation("PatientCurrentSlot", fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([userId, identifierHash])
  @@index([userId])
  @@index([identifierHash])
}

model BillingEvent {
  id              String          @id @default(cuid())
  userId          String?
  provider        BillingProvider
  eventType       String
  providerEventId String          @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model UsageCounter {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  periodEnd        DateTime
  messagesSent     Int      @default(0)
  messagesIncluded Int

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
}

model AuditLog {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  actorType    ActorType
  actorId      String?
  tenantUserId String?
  action       String
  entityType   String?
  entityId     String?
  ipAddress    String?
  userAgent    String?
  beforeJson   Json?
  afterJson    Json?
  metadata     Json?

  @@index([tenantUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
}

model Settings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  confirmationHoursBefore Int      @default(24)
  reminderHoursBefore     Int      @default(6)
  confirmationMessage     String   @default("Olá {nome}, sua consulta na {clinica} está agendada para {data} às {hora}. Responda 1 para CONFIRMAR ou 2 para CANCELAR.")
  reminderMessage         String   @default("Oi {nome}, ainda não recebemos sua confirmação para {data} às {hora} na {clinica}. Responda 1 para CONFIRMAR ou 2 para CANCELAR.")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
