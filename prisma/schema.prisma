// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum AppointmentStatus {
  PENDING
  CONFIRMED
  NOT_CONFIRMED
  CANCELED
  NO_SHOW
}

enum MessageType {
  CONFIRMATION
  REMINDER
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  QUOTA_BLOCKED
}

enum WhatsappStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  FAILED
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum BillingProvider {
  ASAAS
  STRIPE
  PAGARME
}

enum ActorType {
  USER
  SYSTEM
  WEBHOOK
  ADMIN
  ANONYMOUS
}

enum IdentifierType {
  CPF
  PHONE
}

enum GoogleConnectionStatus {
  CONNECTED
  NEEDS_RECONSENT
  REVOKED
}

// Ramo do negócio (onboarding) — dirige a TERMINOLOGIA da UI (ex.: HEALTH usa
// "Paciente"; os demais usam "Cliente"). Ver src/lib/terminology.ts.
enum BusinessType {
  HEALTH // saúde: clínica, psicólogo, dentista → "Paciente"
  AESTHETICS // estética → "Cliente"
  BEAUTY // salão / beleza → "Cliente"
  FINANCE // financeiro / consultoria → "Cliente"
  OTHER // outro → "Cliente"
}

// Models
model User {
  id                         String         @id @default(cuid())
  name                       String
  email                      String         @unique
  password                   String
  clinicName                 String
  avgAppointmentValue        Decimal        @default(0) @db.Decimal(10, 2)
  evolutionInstanceName      String?        @unique
  whatsappStatus             WhatsappStatus @default(DISCONNECTED)
  whatsappPhoneNumber        String?
  whatsappConnectedAt        DateTime?
  // Sprint 8 — resiliência: quando a instância caiu e quando o tenant foi
  // avisado por email pela última vez (dedup de notificações do sweep).
  whatsappDisconnectedAt       DateTime?
  whatsappDisconnectNotifiedAt DateTime?
  lastQrcodeBase64           String?
  lastQrcodeAt               DateTime?
  cpf                        String?
  cpfHash                    String?
  emailVerifiedAt            DateTime?
  emailVerificationToken     String?        @unique
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  patientSlotCount Int @default(0)

  // Onboarding + terminologia por ramo. `businessType` NULL = ainda não
  // escolhido (terminologia cai no default "Paciente"). `onboardingCompletedAt`
  // NULL = mostra o wizard. Usuários EXISTENTES são backfillados (completo) na
  // migration p/ não verem o wizard retroativamente.
  businessType         BusinessType?
  onboardingCompletedAt DateTime?

  // Sprint 11 — LGPD soft-delete + purga (deletedAt != null = conta excluída;
  // patientsPurgedAt = quando a purga 30d apagou os dados de pacientes).
  deletedAt        DateTime?
  patientsPurgedAt DateTime?
  // Sprint 11 — prova de consentimento (um checkbox = termos + privacidade).
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  consentIp         String?

  patients          Patient[]
  appointments      Appointment[]
  settings          Settings?
  subscription      Subscription?
  patientQuotaSlots PatientQuotaSlot[]
  googleCalendar    GoogleCalendarConnection?
  externalEvents    ExternalEvent[]

  @@index([cpfHash])
  @@index([deletedAt])
}

model SignupAttempt {
  id            String   @id @default(cuid())
  ipAddress     String?
  emailHash     String
  cpfHash       String?
  fingerprint   String?
  succeeded     Boolean  @default(false)
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([emailHash, createdAt(sort: Desc)])
  @@index([cpfHash])
}

model Patient {
  id             String    @id @default(cuid())
  name           String
  phone          String
  phoneCanonical String    @default("")
  email          String?
  cpf            String?
  cpfHash        String?
  notes          String?
  userId         String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  quotaSlot    PatientQuotaSlot? @relation("PatientCurrentSlot")

  @@unique([userId, phone])
  @@unique([userId, cpfHash])
  @@index([userId])
  @@index([userId, archivedAt])
}

model Appointment {
  id                 String            @id @default(cuid())
  dateTime           DateTime
  durationMinutes    Int               @default(30)
  status             AppointmentStatus @default(PENDING)
  patientId          String
  userId             String
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  confirmedAt        DateTime?
  notes              String?
  // Fase C (sync app→Google): id do evento espelhado no Google Calendar do
  // tenant (null = ainda não espelhado). Chave da de-dup do overlay no sentido
  // app→Google (o evento que NÓS criamos não pode reaparecer como promovível).
  // NÃO é setado em agendamentos promovidos DO Google (esses têm ExternalEvent;
  // o mirror os ignora). Ver .context/features/google-calendar.md § Fase C.
  googleEventId      String?
  googleCalendarId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageLogs   MessageLog[]
  externalEvent ExternalEvent?

  @@index([userId])
  @@index([patientId])
  @@index([dateTime])
  @@index([status])
  // Índices compostos das queries cross-tenant do scheduler (Sprint 6):
  // sendConfirmations filtra (status, confirmationSentAt); markNoShows (status, dateTime).
  @@index([status, confirmationSentAt])
  @@index([status, dateTime])
}

model MessageLog {
  id            String        @id @default(cuid())
  appointmentId String
  type          MessageType
  sentAt        DateTime      @default(now())
  response      String?
  respondedAt   DateTime?
  status        MessageStatus @default(SENT)
  createdAt     DateTime      @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  plan                   PlanTier           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               BillingProvider?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  adminOverrideUntil     DateTime?
  adminOverrideReason    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

model PatientQuotaSlot {
  id             String         @id @default(cuid())
  userId         String
  identifierType IdentifierType
  identifierHash String
  patientId      String?        @unique
  firstSeenAt    DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation("PatientCurrentSlot", fields: [patientId], references: [id], onDelete: SetNull)

  @@unique([userId, identifierHash])
  @@index([userId])
  @@index([identifierHash])
}

model BillingEvent {
  id              String          @id @default(cuid())
  userId          String?
  provider        BillingProvider
  eventType       String
  providerEventId String          @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
}

model UsageCounter {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  periodEnd        DateTime
  messagesSent     Int      @default(0)
  messagesIncluded Int

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
}

model AuditLog {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  actorType    ActorType
  actorId      String?
  tenantUserId String?
  action       String
  entityType   String?
  entityId     String?
  ipAddress    String?
  userAgent    String?
  beforeJson   Json?
  afterJson    Json?
  metadata     Json?

  @@index([tenantUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
}

model Settings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  confirmationHoursBefore Int      @default(24)
  reminderHoursBefore     Int      @default(6)
  // NÃO inclua a instrução de resposta ("Responda 1 para CONFIRMAR ou 2 para
  // CANCELAR.") aqui: ela é anexada no envio por message-template.ts
  // (withResponseInstruction). O template guarda só o corpo livre.
  confirmationMessage     String   @default("Olá {nome}, sua consulta na {clinica} está agendada para {data} às {hora}.")
  reminderMessage         String   @default("Oi {nome}, ainda não recebemos sua confirmação para a consulta de {data} às {hora} na {clinica}.")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Conexão OAuth por tenant com o Google Calendar (feature PREMIUM). 1:1 com User.
// NÃO faz parte de AUDITED_MODELS (src/lib/audit/prisma-extension.ts): os tokens
// cifrados NUNCA podem cair no AuditLog. Tokens guardados via AES-256-GCM
// (src/lib/services/google/token-crypto.ts). Ver .context/features/google-calendar.md.
model GoogleCalendarConnection {
  id                   String                 @id @default(cuid())
  userId               String                 @unique
  googleAccountEmail   String?
  // Blobs AES-256-GCM versionados (prefixo "g1."). Refresh token é o grant vivo.
  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  // Escopos REALMENTE concedidos (space-joined) — pode diferir do solicitado.
  scopes               String                 @default("")
  calendarId           String                 @default("primary")
  status               GoogleConnectionStatus @default(CONNECTED)
  // Última falha (ex: invalid_grant) p/ surfacing de "Reconectar" na UI.
  lastError            String?
  connectedAt          DateTime               @default(now())
  revokedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Evento do Google Calendar persistido SOMENTE quando promovido a Appointment
// (Fase B — populado lazy na promoção; NÃO há full-sync ainda). FIREWALL: o
// scheduler (sendConfirmations/sendReminders/markNoShows) NUNCA consulta esta
// tabela — só toca Appointment. NÃO faz parte de AUDITED_MODELS (guarda
// título/horário de terceiros). Ver .context/features/google-calendar.md.
model ExternalEvent {
  id            String    @id @default(cuid())
  userId        String
  googleEventId String
  calendarId    String    @default("primary")
  // Snapshot do evento no momento da promoção (contexto + de-dup no overlay).
  title         String
  startsAt      DateTime
  endsAt        DateTime?
  allDay        Boolean   @default(false)
  googleStatus  String?
  // Agendamento gerado pela promoção (1:1). Cascade: apagar o Appointment
  // libera o evento pra reaparecer no overlay e ser promovido de novo.
  appointmentId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId])
}
